{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anti-spin-read",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // rss-parser (xml2js) pulls in Node builtins (events, timers)
  "compatibility_flags": ["nodejs_compat"],

  // Serve the built React SPA from the same Worker as the API.
  // The Worker handles every request (run_worker_first) and falls back to
  // ASSETS.fetch() for anything that isn't /api/*.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // D1 database (SQLite). Create it once per Cloudflare account:
  //   npx wrangler d1 create anti-spin-read
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anti-spin-read",
      "database_id": "4d1d3b1e-e5cc-451c-980a-0d87087fe85c",
      "migrations_dir": "migrations"
    }
  ],

  // Pipeline runs automatically every 15 minutes — no GitHub Actions needed.
  // The second schedule is the framing-only cron (drains the unframed retry
  // queue, up to 14 clusters per run, with no RSS/enrich subrequests). It
  // MUST match FRAMING_CRON_SCHEDULE in src/config.ts — the scheduled
  // handler dispatches on the exact schedule string.
  "triggers": {
    "crons": ["*/15 * * * *", "7,22,37,52 * * * *"]
  },

  // Non-secret config. Secrets (GEMINI_API_KEY, CRON_SECRET) go through:
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put CRON_SECRET
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash",
    "CLUSTER_WINDOW_HOURS": "48",
    // Comma-separated CORS allowlist; default (unset) = local dev origins.
    // Production serves the SPA and API same-origin, so this rarely matters.
    "ALLOWED_ORIGINS": "",
    // Max manual POST /api/cron triggers per IP per 10 minutes (default 5)
    "CRON_RATE_LIMIT": "5"
  }
}
